<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="16dp" android:background="#EDF2F7">
    <TextView android:id="@+id/keresCim" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="Motor keresése" android:textColor="#24354B" android:textSize="22sp" android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <EditText android:id="@+id/keresMarka" android:layout_width="0dp" android:layout_height="52dp"
        android:layout_marginTop="12dp" android:background="@drawable/adat_hatter" android:paddingHorizontal="14dp"
        android:hint="Márka, pl. ducati" android:inputType="text" android:singleLine="true"
        android:text="ducati" android:textColor="#24354B" android:textColorHint="#718096"
        app:layout_constraintTop_toBottomOf="@id/keresCim" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/keresSzoveg"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/adat_hatter"
        android:hint="Modell vagy kategória, pl. enduro"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:textColor="#24354B"
        android:textColorHint="#718096"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/keresMarka" />
    <Button android:id="@+id/keresGomb" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Keresés"
        app:layout_constraintTop_toBottomOf="@id/keresSzoveg" app:layout_constraintStart_toStartOf="parent" />
    <TextView android:id="@+id/keresUzenet" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Írd be a modellt, vagy hagyd üresen az összes motorhoz."
        android:textColor="#546579" android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/keresGomb" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/keresLista"
        android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="10dp"
        android:clipToPadding="false" android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/keresUzenet" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>